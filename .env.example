# Redis Configuration
REDIS_URL=redis://:changeme@redis:6379/0
REDIS_PASSWORD=changeme
SESSION_EXPIRY=86400

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=game_db
DATABASE_URL=postgresql://postgres:postgres@db:5432/game_db

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here

# Supabase Configuration (if used)
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key

# Email / OTP Configuration
# For Gmail, use an app password, not your normal Gmail password.
# For Resend SMTP:
# SMTP_EMAIL=resend
# SMTP_PASSWORD=your_resend_api_key
# SMTP_FROM=your-verified-domain@example.com
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT=8
EMAIL_ATTACH_LOGO=false
# Set this to your deployed frontend URL in production, for example:
# PASSWORD_RESET_BASE_URL=https://your-frontend.example.com
# Local development may use http://localhost:5173.
PASSWORD_RESET_BASE_URL=http://localhost:5173

# CORS Configuration
# Add your deployed frontend origin here, for example:
# FRONTEND_ORIGINS=https://your-frontend.up.railway.app
# If you need multiple origins, separate them with commas.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_ORIGINS=http://localhost:3000

DISCORD_WEBHOOK_URL=""